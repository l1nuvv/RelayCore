{
  "$schema": "https://cmake.org/cmake/help/v4.3/manual/cmake-presets.7.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "RELAYCORE_ENABLE_IPO": "ON",
        "RELAYCORE_ENABLE_ASAN": "ON",
        "RELAYCORE_ENABLE_PCH": "OFF",
        "RELAYCORE_ENABLE_TRACY": "OFF",
        "RELAYCORE_ENABLE_MSVC_ANALYZE": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clangcl-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Fast iteration build with no compiler optimizations.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Optimized release build with /O2 and IPO when supported.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo",
      "description": "Optimized build with debug symbols, PCH, unity build and Tracy instrumentation for profiling.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_UNITY_BUILD": "ON",
        "RELAYCORE_ENABLE_PCH": "ON",
        "RELAYCORE_ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC ASan",
      "description": "AddressSanitizer build mapped to Debug dependencies.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Asan"
      }
    },
    {
      "name": "clangcl-debug",
      "displayName": "clang-cl Debug",
      "description": "Debug build using clang-cl in the Visual Studio environment.",
      "inherits": "clangcl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clangcl-release",
      "displayName": "clang-cl Release",
      "description": "Optimized clang-cl build.",
      "inherits": "clangcl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clangcl-relwithdebinfo",
      "displayName": "clang-cl RelWithDebInfo",
      "description": "Optimized clang-cl build with debug symbols and faster local compilation via unity/PCH.",
      "inherits": "clangcl-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_UNITY_BUILD": "ON",
        "RELAYCORE_ENABLE_PCH": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-msvc-debug",
      "configurePreset": "msvc-debug"
    },
    {
      "name": "build-msvc-release",
      "configurePreset": "msvc-release"
    },
    {
      "name": "build-msvc-relwithdebinfo",
      "configurePreset": "msvc-relwithdebinfo"
    },
    {
      "name": "build-msvc-asan",
      "configurePreset": "msvc-asan"
    },
    {
      "name": "build-clangcl-debug",
      "configurePreset": "clangcl-debug"
    },
    {
      "name": "build-clangcl-release",
      "configurePreset": "clangcl-release"
    },
    {
      "name": "build-clangcl-relwithdebinfo",
      "configurePreset": "clangcl-relwithdebinfo"
    }
  ],
  "testPresets": [
    {
      "name": "test-msvc-debug",
      "configurePreset": "msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc-relwithdebinfo",
      "configurePreset": "msvc-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-msvc-asan",
      "configurePreset": "msvc-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clangcl-debug",
      "configurePreset": "clangcl-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-clangcl-relwithdebinfo",
      "configurePreset": "clangcl-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "workflow-msvc-debug",
      "displayName": "MSVC Debug workflow",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-debug"
        },
        {
          "type": "build",
          "name": "build-msvc-debug"
        },
        {
          "type": "test",
          "name": "test-msvc-debug"
        }
      ]
    },
    {
      "name": "workflow-msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo workflow",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "build-msvc-relwithdebinfo"
        },
        {
          "type": "test",
          "name": "test-msvc-relwithdebinfo"
        }
      ]
    },
    {
      "name": "workflow-msvc-asan",
      "displayName": "MSVC ASan workflow",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-asan"
        },
        {
          "type": "build",
          "name": "build-msvc-asan"
        },
        {
          "type": "test",
          "name": "test-msvc-asan"
        }
      ]
    }
  ]
}
