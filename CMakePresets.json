{
  "$schema": "https://cmake.org/cmake/help/v4.0/manual/cmake-presets.7.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "RELAYCORE_ENABLE_IPO": "OFF",
        "RELAYCORE_ENABLE_ASAN": "OFF",
        "RELAYCORE_ENABLE_TRACY": "OFF",
        "RELAYCORE_ENABLE_MSVC_ANALYZE": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "environment": {
        "PATH": "C:/Program Files/CMake/bin;$penv{PATH}",
        "VSLANG": "1033"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Debug build for day-to-day development.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-relwithdebinfo",
      "displayName": "MSVC RelWithDebInfo",
      "description": "Optimized build with symbols for profiling and normal playtesting.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_UNITY_BUILD": "ON",
        "RELAYCORE_ENABLE_IPO": "ON",
        "RELAYCORE_ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Release build.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_UNITY_BUILD": "ON",
        "RELAYCORE_ENABLE_IPO": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC ASan",
      "description": "ASan build mapped to Debug dependencies.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Asan",
        "RELAYCORE_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "demo-debug",
      "displayName": "Build Demo (Debug)",
      "configurePreset": "msvc-debug",
      "targets": ["relaycore_demo"]
    },
    {
      "name": "demo-relwithdebinfo",
      "displayName": "Build Demo (RelWithDebInfo)",
      "configurePreset": "msvc-relwithdebinfo",
      "targets": ["relaycore_demo"]
    },
    {
      "name": "demo-release",
      "displayName": "Build Demo (Release)",
      "configurePreset": "msvc-release",
      "targets": ["relaycore_demo"]
    },
    {
      "name": "demo-asan",
      "displayName": "Build Demo (ASan)",
      "configurePreset": "msvc-asan",
      "targets": ["relaycore_demo"]
    },
    {
      "name": "tests-debug",
      "displayName": "Build Tests (Debug)",
      "configurePreset": "msvc-debug",
      "targets": ["relaycore_tests"]
    },
    {
      "name": "graphics-baseline-debug",
      "displayName": "Build Graphics Baseline (Debug)",
      "configurePreset": "msvc-debug",
      "targets": ["relaycore_graphics_baseline"]
    },
    {
      "name": "graphics-debug",
      "displayName": "Build Graphics Tests (Debug)",
      "configurePreset": "msvc-debug",
      "targets": [
        "relaycore_window_lifetime_tests",
        "relaycore_game_lifecycle",
        "relaycore_power_restoration_graphics",
        "relaycore_graphics_baseline",
        "relaycore_default_framebuffer_probe"
      ]
    },
    {
      "name": "tests-relwithdebinfo",
      "displayName": "Build Tests (RelWithDebInfo)",
      "configurePreset": "msvc-relwithdebinfo",
      "targets": ["relaycore_tests"]
    },
    {
      "name": "tests-asan",
      "displayName": "Build Tests (ASan)",
      "configurePreset": "msvc-asan",
      "targets": ["relaycore_tests"]
    },
    {
      "name": "validation-debug",
      "displayName": "Build Content Validation (Debug)",
      "configurePreset": "msvc-debug",
      "targets": ["relaycore_content_validation"]
    },
    {
      "name": "validation-relwithdebinfo",
      "displayName": "Build Content Validation (RelWithDebInfo)",
      "configurePreset": "msvc-relwithdebinfo",
      "targets": ["relaycore_content_validation"]
    },
    {
      "name": "validation-asan",
      "displayName": "Build Content Validation (ASan)",
      "configurePreset": "msvc-asan",
      "targets": ["relaycore_content_validation"]
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "msvc-debug",
      "filter": {
        "include": {
          "name": "^relaycore\\."
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "graphics-debug",
      "configurePreset": "msvc-debug",
      "filter": {
        "include": {
          "name": "^graphics\\."
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-relwithdebinfo",
      "configurePreset": "msvc-relwithdebinfo",
      "filter": {
        "include": {
          "name": "^relaycore\\."
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-asan",
      "configurePreset": "msvc-asan",
      "filter": {
        "include": {
          "name": "^relaycore\\."
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "validation-debug",
      "configurePreset": "msvc-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^validation\\."
        }
      }
    },
    {
      "name": "validation-relwithdebinfo",
      "configurePreset": "msvc-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^validation\\."
        }
      }
    },
    {
      "name": "validation-asan",
      "configurePreset": "msvc-asan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^validation\\."
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "tests-debug-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "tests-debug" },
        { "type": "test", "name": "test-debug" }
      ]
    },
    {
      "name": "validation-debug-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "validation-debug" },
        { "type": "test", "name": "validation-debug" }
      ]
    },
    {
      "name": "demo-debug-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "demo-debug" }
      ]
    },
    {
      "name": "debug-discipline-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-debug" },
        { "type": "build", "name": "tests-debug" },
        { "type": "build", "name": "validation-debug" },
        { "type": "test", "name": "test-debug" },
        { "type": "test", "name": "validation-debug" },
        { "type": "build", "name": "demo-debug" }
      ]
    },
    {
      "name": "tests-relwithdebinfo-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-relwithdebinfo" },
        { "type": "build", "name": "tests-relwithdebinfo" },
        { "type": "test", "name": "test-relwithdebinfo" }
      ]
    },
    {
      "name": "validation-relwithdebinfo-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-relwithdebinfo" },
        { "type": "build", "name": "validation-relwithdebinfo" },
        { "type": "test", "name": "validation-relwithdebinfo" }
      ]
    },
    {
      "name": "demo-relwithdebinfo-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-relwithdebinfo" },
        { "type": "build", "name": "demo-relwithdebinfo" }
      ]
    },
    {
      "name": "relwithdebinfo-discipline-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-relwithdebinfo" },
        { "type": "build", "name": "tests-relwithdebinfo" },
        { "type": "test", "name": "test-relwithdebinfo" },
        { "type": "build", "name": "demo-relwithdebinfo" }
      ]
    },
    {
      "name": "tests-asan-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "tests-asan" },
        { "type": "test", "name": "test-asan" }
      ]
    },
    {
      "name": "validation-asan-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "validation-asan" },
        { "type": "test", "name": "validation-asan" }
      ]
    },
    {
      "name": "demo-asan-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "demo-asan" }
      ]
    },
    {
      "name": "asan-discipline-workflow",
      "steps": [
        { "type": "configure", "name": "msvc-asan" },
        { "type": "build", "name": "tests-asan" },
        { "type": "test", "name": "test-asan" },
        { "type": "build", "name": "validation-asan" },
        { "type": "test", "name": "validation-asan" }
      ]
    }
  ]
}
