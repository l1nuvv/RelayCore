root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
