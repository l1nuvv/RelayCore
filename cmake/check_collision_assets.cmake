cmake_minimum_required(VERSION 4.0)
foreach(required IN ITEMS COLLISION_PROJECT_ROOT COLLISION_BUILD_ROOT COLLISION_COMPILER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
set(root "${COLLISION_PROJECT_ROOT}")
set(build "${COLLISION_BUILD_ROOT}")
file(STRINGS "${build}/generated/runtime-collisions.txt" paths)
set(found FALSE)
foreach(path IN LISTS paths)
    if(NOT path MATCHES "^collision/([A-Za-z0-9_-]+)\\.rccollision$")
        message(FATAL_ERROR "Invalid collision path: ${path}")
    endif()
    set(name "${CMAKE_MATCH_1}")
    if(DEFINED COLLISION_INSPECT_NAME AND NOT name STREQUAL COLLISION_INSPECT_NAME)
        continue()
    endif()
    set(found TRUE)
    set(receipt_path "${build}/generated/collision-receipts/${name}.json")
    file(READ "${receipt_path}" receipt)
    string(JSON version GET "${receipt}" version)
    string(JSON model GET "${receipt}" model)
    if(DEFINED COLLISION_INSPECT_NAME)
        message(STATUS "Source: content/collision/${name}.toml\nProduct: ${path}\nPaired model: ${model}\nReceipt version: ${version}")
    endif()
    if(NOT version EQUAL 1 OR NOT model MATCHES "^models/[A-Za-z0-9_-]+\\.rcmodel$")
        message(FATAL_ERROR "Invalid collision receipt: ${receipt_path}")
    endif()
    set(source "${root}/content/collision/${name}.toml")
    set(compiler "${COLLISION_COMPILER}")
    set(rule "${root}/cmake/compile_collision_asset.cmake")
    set(declaration "${root}/cmake/RelayCoreCollisionAssets.cmake")
    set(product "${build}/generated/model-assets/${path}")
    set(model_reference "${model}")
    set(model "${build}/generated/model-assets/${model}")
    foreach(input IN ITEMS source compiler rule declaration product model)
        string(JSON expected GET "${receipt}" ${input}_sha256)
        file(SHA256 "${${input}}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Collision ${name} is stale or differs (${input}); rebuild assets")
        endif()
    endforeach()
    if(DEFINED COLLISION_RUNTIME_ASSETS)
        file(SHA256 "${COLLISION_RUNTIME_ASSETS}/${path}" staged)
        file(SHA256 "${product}" actual)
        if(NOT staged STREQUAL actual)
            message(FATAL_ERROR "Staged collision ${name} differs; rebuild assets")
        endif()
        file(SHA256 "${COLLISION_RUNTIME_ASSETS}/${model_reference}" staged_model)
        file(SHA256 "${model}" actual_model)
        if(NOT staged_model STREQUAL actual_model)
            message(FATAL_ERROR "Staged model paired with collision ${name} differs; rebuild assets")
        endif()
    endif()
endforeach()
if(DEFINED COLLISION_INSPECT_NAME)
    if(NOT found)
        message(FATAL_ERROR "No build receipt for collision ${COLLISION_INSPECT_NAME}")
    endif()
    message(STATUS "Collision receipt and staged product are current (SHA-256)")
endif()
