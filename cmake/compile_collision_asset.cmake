cmake_minimum_required(VERSION 4.0)
foreach(required IN ITEMS SOURCE PRODUCT RECEIPT COMPILER MODEL MODEL_REFERENCE DECLARATION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
set(RULE "${CMAKE_CURRENT_LIST_FILE}")
set(inputs SOURCE COMPILER MODEL DECLARATION RULE)
foreach(input IN LISTS inputs)
    file(SHA256 "${${input}}" ${input}_hash)
endforeach()
get_filename_component(product_directory "${PRODUCT}" DIRECTORY)
get_filename_component(receipt_directory "${RECEIPT}" DIRECTORY)
file(MAKE_DIRECTORY "${product_directory}" "${receipt_directory}")
execute_process(COMMAND "${COMPILER}" "${SOURCE}" "${PRODUCT}.pending.rccollision" "${MODEL_REFERENCE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Collision compilation failed: ${SOURCE}\n${output}${error}")
endif()
foreach(input IN LISTS inputs)
    file(SHA256 "${${input}}" after)
    if(NOT "${${input}_hash}" STREQUAL "${after}")
        file(REMOVE "${PRODUCT}.pending.rccollision")
        message(FATAL_ERROR "${input} changed during collision compilation; rebuild ${SOURCE}")
    endif()
endforeach()
file(SHA256 "${PRODUCT}.pending.rccollision" product_hash)
file(WRITE "${RECEIPT}.tmp"
    "{\n  \"version\": 1,\n  \"source_sha256\": \"${SOURCE_hash}\",\n"
    "  \"compiler_sha256\": \"${COMPILER_hash}\",\n  \"rule_sha256\": \"${RULE_hash}\",\n"
    "  \"model_sha256\": \"${MODEL_hash}\",\n  \"model\": \"${MODEL_REFERENCE}\",\n"
    "  \"declaration_sha256\": \"${DECLARATION_hash}\",\n  \"product_sha256\": \"${product_hash}\"\n}\n")
file(RENAME "${PRODUCT}.pending.rccollision" "${PRODUCT}")
file(RENAME "${RECEIPT}.tmp" "${RECEIPT}")
message(STATUS "${output}")
