CompileFlags:
  CompilationDatabase: Ancestors
  Compiler: clang-cl
  Add:
    - -Wall
    - -Wextra
    - -Wpedantic
  Remove:
    - /analyze
    - /external:*
    - /fsanitize=address
    - -fsanitize=address
    - -Werror

Index:
  Background: Build
  StandardLibrary: true

Style:
  QuotedHeaders:
    - "src/.*"
    - "tests/.*"
  AngledHeaders:
    - "extern/.*"

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - clang-analyzer-*
      - performance-*
      - modernize-use-nullptr
      - modernize-use-override
      - modernize-use-using
      - readability-avoid-const-params-in-decls
      - readability-redundant-*
    Remove:
      - bugprone-easily-swappable-parameters
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - readability-magic-numbers
    FastCheckFilter: Strict
  UnusedIncludes: Strict
  MissingIncludes: None

Completion:
  HeaderInsertion: IWYU

InlayHints:
  Enabled: true
  DeducedTypes: true
  ParameterNames: true
  DefaultArguments: false

---
If:
  PathMatch:
    - extern/.*
    - build/.*
    - cmake-build-.*/.*
Index:
  Background: Skip
Diagnostics:
  Suppress: '*'
