{
  "name": "relaycore",
  "version-string": "0.1.0",
  "builtin-baseline": "a9f0cd0345fb29cd227d802f1fd1917c28f8e5a3",
  "description": "Starter project for a small retro-FPS / GoldSrc-like engine prototype using SDL3, OpenGL, GLM, spdlog, ImGui, miniaudio, doctest and toml++.",
  "license": "MIT",
  "dependencies": [
    {
      "name": "sdl3"
    },
    {
      "name": "spdlog"
    },
    {
      "name": "glm"
    },
    {
      "name": "imgui",
      "default-features": false,
      "features": [
        "opengl3-binding",
        "sdl3-binding"
      ]
    },
    {
      "name": "doctest"
    },
    {
      "name": "miniaudio"
    },
    {
      "name": "tomlplusplus"
    },
    {
      "name": "tracy"
    }
  ]
}
