{
  "name": "relaycore",
  "version-string": "1.3.4",
  "builtin-baseline": "40f3c709db80acf154ac4b17a1f83c564ebd022e",
  "description": "Starter project for a small retro indoor FPS / engine-programming prototype using SDL3, OpenGL, GLM, spdlog, ImGui, miniaudio, doctest, Tracy, and toml++.",
  "license": "MIT",
  "supports": "windows",
  "dependencies": [
    "doctest",
    "glm",
    {
      "name": "imgui",
      "default-features": false,
      "features": [
        "opengl3-binding",
        "sdl3-binding"
      ]
    },
    "miniaudio",
    "sdl3",
    "spdlog",
    "tomlplusplus",
    "tracy"
  ]
}
