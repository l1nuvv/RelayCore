{
  "name": "relaycore",
  "version-string": "1.3.4",
  "builtin-baseline": "a42757564758c60651ebc616d9b000b7b91249ef",
  "description": "Starter project for a small retro indoor FPS / engine-programming prototype using SDL3, Vulkan, GLM, spdlog, ImGui, miniaudio, doctest, Tracy, and toml++.",
  "license": "MIT",
  "supports": "windows",
  "dependencies": [
    "doctest",
    "fastgltf",
    "glm",
    {
      "name": "imgui",
      "default-features": false,
      "features": [

        "sdl3-binding",
        "vulkan-binding"
      ]
    },
    "miniaudio",
    {
      "name": "sdl3",
      "features": ["vulkan"]
    },
    {
      "name": "shader-slang",
      "host": true
    },
    "spdlog",
    "tomlplusplus",
    "tracy",
    "vk-bootstrap",
    "vulkan-memory-allocator"
  ]
}
